{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.build.tsbuildinfo",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": false,
    "rootDir": "../..",
    "outDir": "./dist/types",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": ["react", "react-dom", "node", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "@compsable-search/core": ["../core/src/index.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["test/**/*"]
}
