{
  "compilerOptions": {
    "tsBuildInfoFile": "../../node_modules/.tmp/apps-demo.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client", "vitest/globals"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "baseUrl": ".",
    "paths": {
      "@compsable-search/react": ["../../packages/react/src/index.ts"],
      "@compsable-search/react/style.css": ["../../packages/react/src/style.css"],
      "@compsable-search/selector-region": ["../../packages/selector-region/src/index.ts"],
      "@compsable-search/selector-keyword": ["../../packages/selector-keyword/src/index.ts"]
    }
  },
  "include": ["src"]
}
