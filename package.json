{
  "name": "@compsable-search/workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @compsable-search/demo",
    "lint:root": "eslint \"scripts/**/*.{js,mjs}\" \"*.config.{js,ts}\" --max-warnings=0",
    "lint": "npm run lint:root && node ./scripts/run-workspaces.mjs lint",
    "test": "node ./scripts/run-workspaces.mjs test",
    "typecheck": "node ./scripts/run-workspaces.mjs typecheck",
    "build": "node ./scripts/run-workspaces.mjs build",
    "validate:contracts": "node ./scripts/validate-contracts.mjs",
    "verify:exports": "npm run validate:contracts && node ./scripts/verify-package.mjs",
    "pack": "npm run build && npm run verify:exports && node ./scripts/pack-workspaces.mjs",
    "ci:workspace": "npm run lint && npm run test && npm run typecheck && npm run pack"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "28.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "4.0.18"
  }
}
